  "calculatorHtml": "<h3>2026-2027</h3><script>var min_psych = 700;\nfunction med_meshuklal_func_a(bag,psy){\n\t\tvar B = 3.9630 * bag - 20.0621;\n\t\tvar P = 0.032073 * psy + 0.3672;\n\t\tvar X = 0.3 * B + 0.7 * P;\n\t\tvar Y = Math.floor((1.2235 * X - 4.4598+0.0005)*1000)/1000;\n\n\t\tif (isNaN(Y) || psy > 800 || psy < 200 || bag < 6 || bag >12.7)\n      { Y= \"אחד או כמה מהערכים שהזנת אינם חוקיים, אנא נסו שוב\";}\n\t\telse if (psy < min_psych) {\n\t\tY=\"ציון הפסיכומטרי שלך נמוך מהמינימום הנדרש לחוג\";\n\t\t}\n    <!-- present results -->\n    console.log(\"B:\",B);\n    console.log(\"P:\",P);\n    console.log(\"X\",X);\n    console.log(\"Y\",Y);\n\n    document.getElementById(\"text_a\").innerHTML= \"ציון משוקלל לפי פסיכומטרי ובגרות:\";\n    document.getElementById(\"text_a\").style.direction=\"rtl\";\n\n    document.getElementById(\"result_a\").innerHTML= Y;\n    document.getElementById(\"result_a\").style.direction=\"rtl\";\n\n\t}\nfunction med_meshuklal_func_c(mechina,psy){\n\t\tvar B = 3.9261 * mechina- 15.9285;\n\t\tvar P = 0.032073 * psy + 0.3672;\n\t\tvar X = 0.5 * B + 0.5 * P;\n\t\tvar Y = Math.floor((1.2422 * X - 4.7609+0.0005)*1000)/1000;\n\n\t\tif (isNaN(Y) || psy > 800 || psy < 200 || mechina < 6 || mechina > 11.3)\n      { Y= \"אחד או כמה מהערכים שהזנת אינם חוקיים, אנא נסו שוב\";}\n\t\telse if (psy < min_psych) {\n\t\tY=\"ציון הפסיכומטרי שלך נמוך מהמינימום הנדרש לחוג\";\n\t\t}\n    <!-- present results -->\n    console.log(\"B:\",B);\n    console.log(\"P:\",P);\n    console.log(\"X\",X);\n    console.log(\"Y\",Y);\n\n    document.getElementById(\"text_a\").innerHTML= \"ציון משוקלל לפי פסיכומטרי ומכינת העברית משנת תשפ\\\"א ואילך:\";\n    document.getElementById(\"text_a\").style.direction=\"rtl\";\n\n    document.getElementById(\"result_a\").innerHTML= Y;\n    document.getElementById(\"result_a\").style.direction=\"rtl\";\n\n\t}\nfunction med_meshuklal_func_d(mechina,psy){\n\t\tvar B = 3.6201 * mechina- 12.1296;\n\t\tvar P = 0.032073 * psy + 0.3672;\n\t\tvar X = 0.5 * B + 0.5 * P;\n\t\tvar Y = Math.floor((1.2422 * X - 4.7609+0.0005)*1000)/1000;\n\n\t\tif (isNaN(Y) || psy > 800 || psy < 200 || mechina < 6 || mechina > 11.3)\n      { Y= \"אחד או כמה מהערכים שהזנת אינם חוקיים, אנא נסו שוב\";}\n\t\telse if (psy < min_psych) {\n\t\tY=\"ציון הפסיכומטרי שלך נמוך מהמינימום הנדרש לחוג\";\n\t\t}\n    <!-- present results -->\n    console.log(\"B:\",B);\n    console.log(\"P:\",P);\n    console.log(\"X\",X);\n    console.log(\"Y\",Y);\n\n    document.getElementById(\"text_a\").innerHTML= \"ציון משוקלל לפי מכינת העברית עד תש\\\"ף ומכינות אחרות:\";\n    document.getElementById(\"text_a\").style.direction=\"rtl\";\n\n    document.getElementById(\"result_a\").innerHTML= Y;\n    document.getElementById(\"result_a\").style.direction=\"rtl\";\n\n\t}\nfunction med_meshuklal_func_b(mesh,m){\n    var Y = mesh;\n\n    <!-- Mor/Mirkam Standardization (Tiknun) -->\n    var M = 0.0290 * m + 19.9393;\n\n    <!-- Personal Grade (Tziun Ishiuty): -->\n    var S = Math.floor(((0.6 * M + 0.4 * Y)+0.0005)*1000)/1000;\n\tconsole.log(\"Y\",Y);\n\tconsole.log(\"M\",M);\n\tconsole.log(\"S\",S);\n    <!-- check vlaues validity -->\n    if (isNaN(S) || m < 150 || m >250 || mesh< 16.000 || mesh > 30.000)\n      { S= \"אחד או כמה מהערכים שהזנת אינם חוקיים, אנא נסו שוב\";}\n    <!-- present results -->\n    document.getElementById(\"result_b\").innerHTML= S;\n    document.getElementById(\"result_b\").style.direction=\"rtl\";\n}</script>",
