# Local development example: use a direct Postgres URL here.
# Preview/production app runtime should use the intended Supabase pooled URL in Vercel.
DATABASE_URL=
OPS_DATABASE_URL=
CATALOGUE_SOURCE_MODE=auto
INTERNAL_ADMIN_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Deployed app origin used for Supabase email redirects and OAuth callback redirects.
# Example: https://toar.example.com
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional enquiry notifications. No notification is sent unless both are set.
# Use a leads channel; ready-PR and admissions-review channels are never fallbacks.
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL_ID=
